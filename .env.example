# ============================================================
# RecruitFlow ATS - Environment Configuration
# Copy this file to .env and fill in the values
# ============================================================

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://recruitflow:recruitflow_dev@localhost:5432/recruitflow
DATABASE_URL_SYNC=postgresql://recruitflow:recruitflow_dev@localhost:5432/recruitflow

# ---------- Authentication ----------
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Application ----------
APP_NAME=RecruitFlow
APP_ENV=development
DEBUG=true
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Email / SMTP ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=noreply@recruitflow.dev
EMAIL_FROM_NAME=RecruitFlow

# ---------- File Uploads ----------
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE_MB=10

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Logging ----------
LOG_LEVEL=INFO

# ---------- Demo Seed (development only) ----------
DEMO_ADMIN_EMAIL=admin@recruitflow.dev
DEMO_ADMIN_PASSWORD=change-this-password
